{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cheatvision-share",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "account_id": "9c5f81e73d237bab60bdb0bc2085cd56",
  "r2_buckets": [
    {
      "binding": "SHARE_BUCKET",
      "bucket_name": "cheatvision-share"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "cheatvision-share-auth",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "41005",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "42005",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
