{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cheatvision-support",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "account_id": "9c5f81e73d237bab60bdb0bc2085cd56",
  "r2_buckets": [
    {
      "binding": "SUPPORT_BUCKET",
      "bucket_name": "cheatvision-support-logs"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "31005",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
